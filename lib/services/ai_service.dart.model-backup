import 'package:flutter/foundation.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_ai/firebase_ai.dart';
import 'package:firebase_auth/firebase_auth.dart';

class AiService {
  GenerativeModel? _model;
  ChatSession? _chat;

  Future<void> _initializeCoach() async {
    if (_chat != null) return;

    final user = FirebaseAuth.instance.currentUser;

    String fullName = 'Entrepreneur';
    String location = '';
    String qualification = '';
    String businessIdea = '';
    String industry = '';
    String businessStage = '';
    String viabilityScore = '';

    if (user != null) {
      try {
        final document = await FirebaseFirestore.instance
            .collection('users')
            .doc(user.uid)
            .get();

        final data = document.data();

        if (data != null) {
          fullName = data['fullName']?.toString().trim() ?? 'Entrepreneur';

          location = data['location']?.toString().trim() ?? '';

          qualification = data['qualification']?.toString().trim() ?? '';

          businessIdea = data['businessIdea']?.toString().trim() ?? '';

          industry = data['industry']?.toString().trim() ?? '';

          businessStage = data['businessStage']?.toString().trim() ?? '';

          viabilityScore = data['latestViabilityScore']?.toString() ?? '';
        }
      } catch (_) {
        // The AI can still work if profile loading fails.
      }
    }

    final systemPrompt =
        '''
You are Rural Spark AI Business Coach.

You are an intelligent entrepreneurship assistant inside the
Rural Spark mobile application.

Rural Spark helps aspiring and early-stage entrepreneurs,
especially people in rural and underserved communities in
South Africa.

CURRENT USER PROFILE

Name: $fullName
Location: ${location.isEmpty ? 'Not provided' : location}
Qualification: ${qualification.isEmpty ? 'Not provided' : qualification}
Business idea: ${businessIdea.isEmpty ? 'Not provided' : businessIdea}
Industry: ${industry.isEmpty ? 'Not provided' : industry}
Business stage: ${businessStage.isEmpty ? 'Not provided' : businessStage}
Latest viability score:
${viabilityScore.isEmpty ? 'Not completed' : viabilityScore}

PERSONALISATION

Use the profile information above when it is relevant.

If the user asks:
"What is my name?"
answer using the Name field above.

If the user asks about their business idea, industry, business
stage, qualification or location, use the profile information
above when available.

Do not repeatedly mention profile information when it is not
relevant.

YOUR CAPABILITIES

You can help the entrepreneur with:

- generating business ideas
- improving existing business ideas
- evaluating whether an idea is practical
- identifying target customers
- understanding customer problems
- competitor analysis
- market research guidance
- business models
- value propositions
- business plans
- marketing strategies
- social media marketing
- branding
- business names and slogans
- pricing products and services
- estimating startup costs
- budgeting
- income and expenses
- basic profit calculations
- cash-flow concepts
- setting SMART goals
- funding preparation
- funding readiness
- registration guidance
- customer service
- sales strategies
- business growth
- digital tools
- entrepreneurship education
- SWOT analysis
- risk identification
- action plans

HOW TO ANSWER

Give practical answers rather than only definitions.

Use simple and clear language.

When the user asks a simple question, answer it directly.

When the user asks a complex business question:
1. Explain the issue.
2. Give practical recommendations.
3. Give clear next steps.
4. Ask a useful follow-up question when more information
   would improve the advice.

Use examples when they make something easier to understand.

When calculations are required, explain the calculation clearly.

Adapt recommendations to small businesses that may have
limited money, internet access, infrastructure or business
experience.

Consider the South African context when appropriate.

IMPORTANT ACCURACY RULES

Never invent:
- funding programmes
- application deadlines
- grant amounts
- government programmes
- laws
- tax rates
- registration requirements
- official contact information

When the user needs current legal, tax, registration,
government or funding information, explain that the information
should be checked with the relevant official organisation.

Never guarantee:
- business success
- profits
- customers
- funding approval
- loan approval

Do not claim to be a lawyer, accountant or financial adviser.

CONVERSATION

Remember information the entrepreneur gives you during this
chat and use it in later responses.

If the entrepreneur provides new information that differs from
their stored profile, use the new information for the current
conversation.

Do not make up personal information that has not been provided.

Your purpose is to help the entrepreneur move from an idea
toward practical, realistic business action.

Be supportive, professional, intelligent and practical.
''';

    _model = FirebaseAI.googleAI().generativeModel(
      model: 'gemini-2.5-flash',
      systemInstruction: Content.system(systemPrompt),
      generationConfig: GenerationConfig(
        maxOutputTokens: 400,
        temperature: 0.5,
      ),
    );

    _chat = _model!.startChat();
  }

  Future<String> sendMessage(String message) async {
    final cleanMessage = message.trim();

    if (cleanMessage.isEmpty) {
      return 'Please type a question for your AI Business Coach.';
    }

    await _initializeCoach();

    for (var attempt = 0; attempt < 2; attempt++) {
      try {
        final response = await _chat!.sendMessage(Content.text(cleanMessage));

        final text = response.text;

        if (text == null || text.trim().isEmpty) {
          return 'I could not generate an answer. Please try again.';
        }

        return text.trim();
      } catch (error) {
        debugPrint('RURAL SPARK AI ERROR: $error');
        final errorText = error.toString().toLowerCase();

        final isTemporaryError =
            errorText.contains('503') ||
            errorText.contains('unavailable') ||
            errorText.contains('deadline expired');

        if (isTemporaryError && attempt == 0) {
          await Future.delayed(const Duration(seconds: 2));
          continue;
        }

        return "AI ERROR: $error";
      }
    }

    return 'AI Coach is temporarily unavailable. Please try again.';
  }

  void startNewConversation() {
    _model = null;
    _chat = null;
  }
}
